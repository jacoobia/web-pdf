#!/bin/sh
msg=$(grep -v '^#' "$1" | sed '/^[[:space:]]*$/d')
lines=$(printf '%s\n' "$msg" | wc -l)
types='feat|fix|perf|refactor|docs|test|chore|ci|build|style|revert'
if [ "$lines" -ne 1 ] || [ "${#msg}" -gt 72 ] ||
  ! printf '%s' "$msg" | grep -Eq "^($types)(\([a-z0-9-]+\))?: [^A-Z]+$"; then
  echo "Commit message must be one lower-case line of 72 characters or fewer, like \"fix: wrap long words\"." >&2
  echo "Types: $types" | tr '|' ' ' >&2
  exit 1
fi
